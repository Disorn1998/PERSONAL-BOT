# persona-bot — environment template (no secrets)
# Copy to `.env` locally. Never commit `.env`.

# --- Groq (BYOK) ---
# Leave empty in committed examples; set locally only.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
# Model IDs come from config only — never hardcode in Python.
# Recommended replacements after 2026 Llama deprecations (verify on console.groq.com/docs/deprecations):
GROQ_MODEL_PRIMARY=openai/gpt-oss-120b
GROQ_MODEL_FALLBACK=openai/gpt-oss-20b

# --- App paths / limits (§16 / Appendix A) ---
APP_PASSWORD=
EXAMPLES_DIR=personas/examples
PERSONAS_DIR=data/personas
MAX_KNOWLEDGE_MB=50
LLM_TIMEOUT_SECONDS=60
LOG_LEVEL=INFO

# Display-only daily token budget hint (does not enforce API quota). F12.
DAILY_TOKEN_LIMIT=

# Optional: remember API key outside data/ (opt-in; never exported).
# PERSONA_BOT_REMEMBER_KEY=0
