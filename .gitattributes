# Keep LF in the working tree on Windows so ruff format --check matches CI Linux.
* text=auto eol=lf

# Explicitly binary — do not convert
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary
*.sqlite3 binary
